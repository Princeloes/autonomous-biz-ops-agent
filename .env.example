# LLM configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o

# Langfuse configuration (Observability)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Mem0 configuration (Memory)
MEM0_API_KEY=your_mem0_api_key_here
# If MEM0_API_KEY is not provided, the agent falls back to local sqlite/chromadb memory.

# Tool API Keys
TAVILY_API_KEY=your_tavily_api_key_here

# MCP Servers configurations (JSON array of server configs)
# E.g. [{"name": "fetch", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-fetch"]}]
MCP_SERVERS=[]
